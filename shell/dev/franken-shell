	request_id=$2
	api_version=$(show_ipc_version | jq -er '.apiVersion')
	envelope=$(jq -cn \
		--argjson apiVersion "$api_version" \
		--arg requestId "$request_id" \
		--arg operation "$operation" \
		'{apiVersion:$apiVersion,requestId:$requestId,operation:$operation,payload:{}}')
	qs ipc --path "$SHELL_DIR" call shell request "$envelope"
}

run_command_demo() {
	if is_running; then
		printf 'command-demo refuses to reuse an existing Franken Shell instance.\n' >&2
		return 1
	fi

	fixture="$CONFIG_FIXTURE_DIR/command_registry_demo.toml"
	mkdir -p "$CONFIG_DEMO_DIR"
	chmod 700 "$CONFIG_DEMO_DIR"
	cp "$fixture" "$CONFIG_DEMO_DIR/config.toml"
	if ! start_instance command-demo "$CONFIG_DEMO_DIR/config.toml"; then
		rm -rf "$CONFIG_DEMO_DIR"
		return 1
	fi

	attempts=0
	while [ "$attempts" -lt 50 ]; do
		summary=$(qs ipc --path "$SHELL_DIR" call diagnostics commandStatus 2>/dev/null) || summary=
		case "$summary" in
		*'"registeredCommandCount":1'*'"availableCommandCount":1'*) break ;;
		esac
		attempts=$((attempts + 1))
		sleep 0.1
	done
	if [ "$attempts" -ge 50 ]; then
		printf 'The fixed development.commandDemo command is not available in the active snapshot.\n' >&2
		return 1
	fi
	result=$(qs ipc --path "$SHELL_DIR" call diagnostics commandDemo)
	case "$result" in
	*'"state":"unavailable"'*)
		printf 'The fixed development.commandDemo request was rejected: %s\n' "$result" >&2
		return 1
		;;
	esac
	printf '%s\n' "$result"
}

