check_command_registry() {
	"$QMLLINT" -I "$SHELL_DIR" -I /usr/lib/qt6/qml \
		"$SHELL_DIR/core/CommandProcessSlot.qml" \
		"$SHELL_DIR/core/CommandRegistry.qml" \
		"$SHELL_DIR/tests/command_registry/FakeCommandConfigService.qml" \
		"$SHELL_DIR/tests/command_registry/CommandRegistryTests.qml"

	if rg -n \
		-e 'startDetached' \
		-e 'execDetached' \
		-e 'eval[[:space:]]*\(' \
		-e "['\"](sh|bash)['\"][[:space:]]*,[[:space:]]*['\"]-c['\"]" \
		-e 'process\.(environment|workingDirectory)' \
		"$SHELL_DIR/core/CommandProcessSlot.qml" \
		"$SHELL_DIR/core/CommandRegistry.qml"; then
		printf 'CommandRegistry static safety check found a forbidden execution path.\n' >&2
		return 1
	fi

	if rg -n \
		-e '^CommandProcessSlot[[:space:]]' \
		"$SHELL_DIR/core/qmldir"; then
		printf 'CommandProcessSlot must remain private to CommandRegistry.\n' >&2
		return 1
	fi

	if rg -n \
		-e 'function execute\([^)]*,' \
		-e 'optionalContext' \
		"$SHELL_DIR/core/CommandRegistry.qml"; then
		printf 'CommandRegistry execute must remain a stable-ID-only API.\n' >&2
		return 1
	fi

	registry_count=$(rg -c 'Core\.CommandRegistry[[:space:]]*\{' "$SHELL_DIR/shell.qml")
	if [ "$registry_count" -ne 1 ]; then
		printf 'Expected exactly one root CommandRegistry, found %s.\n' "$registry_count" >&2
		return 1
	fi

	if ! rg -q 'root\.mode !== "command-demo"' "$SHELL_DIR/core/Diagnostics.qml"; then
		printf 'The harmless command demo must remain restricted to command-demo mode.\n' >&2
		return 1
	fi
}

