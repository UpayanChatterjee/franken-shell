	runtime_count=$(rg -c 'AudioServices\.QuickshellPipewireRuntime[[:space:]]*\{' "$SHELL_DIR/shell.qml")
	if [ "$runtime_count" -ne 1 ]; then
		printf 'Expected exactly one root PipeWire runtime, found %s.\n' "$runtime_count" >&2
		return 1
	fi

	backend_import_count=$(rg -l '^import Quickshell\.Services\.Pipewire' "$SHELL_DIR" -g '*.qml' | wc -l)
	if [ "$backend_import_count" -ne 1 ]; then
		printf 'Expected PipeWire backend access in exactly one runtime file, found %s files.\n' "$backend_import_count" >&2
		return 1
	fi
}

