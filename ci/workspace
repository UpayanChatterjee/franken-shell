#!/bin/sh

set -eu

# shellcheck source=ci/lib.sh
. "$(dirname -- "$0")/lib.sh"

require_tool qs

cd "$REPO_ROOT"

workspace_artifact_dir="$ARTIFACT_DIR/workspace"
mkdir -p "$workspace_artifact_dir"

unset WAYLAND_DISPLAY
unset HYPRLAND_INSTANCE_SIGNATURE
export QT_QPA_PLATFORM=offscreen

if shell/dev/franken-shell workspace-check >"$workspace_artifact_dir/check.log" 2>&1; then
	cat "$workspace_artifact_dir/check.log"
else
	status=$?
	cat "$workspace_artifact_dir/check.log" >&2
	exit "$status"
fi

if shell/dev/franken-shell workspace-test >"$workspace_artifact_dir/test.log" 2>&1; then
	cat "$workspace_artifact_dir/test.log"
else
	status=$?
	cat "$workspace_artifact_dir/test.log" >&2
	exit "$status"
fi

printf 'Workspace controller and component fixtures passed.\n'
