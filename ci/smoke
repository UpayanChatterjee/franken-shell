#!/bin/sh

set -eu

# shellcheck source=ci/lib.sh
. "$(dirname -- "$0")/lib.sh"

require_tool jq
require_tool pgrep
require_tool ps
require_tool qs
require_tool rg
require_tool tr

cd "$REPO_ROOT/shell"

runtime_dir=$(mktemp -d "${TMPDIR:-/tmp}/fsci.XXXXXX")
chmod 700 "$runtime_dir"
smoke_artifact_dir="$ARTIFACT_DIR/smoke"
mkdir -p "$smoke_artifact_dir"
: >"$smoke_artifact_dir/results.txt"

export QT_QPA_PLATFORM=offscreen
export NO_COLOR=1
export QS_NO_RELOAD_POPUP=1
export XDG_RUNTIME_DIR="$runtime_dir"
unset WAYLAND_DISPLAY
unset HYPRLAND_INSTANCE_SIGNATURE

cleanup() {
	./dev/franken-shell stop >/dev/null 2>&1 || true
	rm -rf "$runtime_dir"
}
trap cleanup EXIT INT TERM

shell_instances() {
	instance_json=$(qs list --all --json 2>/dev/null) || return 1
	if [ "$instance_json" = "No running instances." ]; then
		printf '[]\n'
		return 0
	fi
	printf '%s\n' "$instance_json" |
		jq --arg config "$REPO_ROOT/shell/shell.qml" \
			'[.[] | select(.config_path == $config)]' 2>/dev/null
}

assert_degraded_summary() {
	jq -e '
        .mode == "mock"
        and .startupState == "Degraded"
        and .shellReady == true
        and .shellDegraded == true
        and .shellFailed == false
        and .configHealth == "healthy"
        and .configSourceState == "defaultsOnly"
        and .surfaceVisible == true
        and .monitorBackendAvailability == "fixture"
        and .monitorConnectedCount == 1
        and .monitorMappedCount == 1
        and .monitorUnmappedCount == 0
        and .barHostCount == 1
        and .barResolvedHostCount == 1
        and .barVisibleHostCount == 1
        and .commandActiveRequestCount == 0
        and .commandQueuedRequestCount == 0
        and .capabilityEvaluated == true
        and .capabilityUnavailableCount == 7
        and .diagnosticServiceCount == 5
        and .surfaceActiveCount == 0
        and .surfaceLastTransition == "idle"
        and .themeHealth == "healthy"
        and .themeSource == "builtInFallback"
    ' >/dev/null
}

collect_descendants() {
	parent=$1
	children=$(pgrep -P "$parent" 2>/dev/null || true)
	for child in $children; do
		printf '%s\n' "$child"
		collect_descendants "$child"
	done
}

wait_for_unregistered() {
	attempts=0
	while [ "$attempts" -lt 50 ]; do
		instances=$(shell_instances || true)
		if [ -n "$instances" ] &&
			printf '%s\n' "$instances" | jq -e 'length == 0' >/dev/null 2>&1; then
			return 0
		fi
		attempts=$((attempts + 1))
		sleep 0.1
	done
	return 1
}

wait_for_process_exit() {
	pid=$1
	attempts=0
	while [ "$attempts" -lt 50 ]; do
		if ! kill -0 "$pid" 2>/dev/null; then
			return 0
		fi
		process_state=$(ps -o stat= -p "$pid" 2>/dev/null |
			tr -d '[:space:]' || true)
		case "$process_state" in
		"" | Z*) return 0 ;;
		esac
		attempts=$((attempts + 1))
		sleep 0.1
	done
	return 1
}

capture_log_policy() {
	label=$1
	expected_startups=$2
	additional_baseline=${3:-}
	log_output=$(qs log --path "$REPO_ROOT/shell" --tail 1000)
	printf '%s\n' "$log_output" >"$smoke_artifact_dir/$label-quickshell.log"
	startup_count=$(printf '%s\n' "$log_output" |
		rg -c 'franken\.core: .*"event":"startup"' || true)
	if [ "$startup_count" -ne "$expected_startups" ]; then
		die "expected $expected_startups startup events for $label, found $startup_count"
	fi

	suspect_log=$(printf '%s\n' "$log_output" |
		rg -i '(^|[[:space:]])(WARN|ERROR):|binding[ -]?loop|QQmlComponent' || true)
	if [ -n "$additional_baseline" ]; then
		unexpected_log=$(printf '%s\n' "$suspect_log" |
			rg -v -f "$CI_DIR/baselines/smoke-known.txt" \
				-f "$additional_baseline" || true)
	else
		unexpected_log=$(printf '%s\n' "$suspect_log" |
			rg -v -f "$CI_DIR/baselines/smoke-known.txt" || true)
	fi
	if [ -n "$unexpected_log" ]; then
		printf '%s\n' "$unexpected_log" >"$smoke_artifact_dir/$label-unexpected-warnings.log"
		die "$label smoke logs contain an unexpected warning or error"
	fi
}

stop_and_check() {
	label=$1
	pid=$2
	descendant_pids=$(collect_descendants "$pid")
	printf '%s\n' "$descendant_pids" >"$smoke_artifact_dir/$label-descendant-pids.txt"
	./dev/franken-shell stop >"$smoke_artifact_dir/$label-stop.log"

	if ! wait_for_unregistered; then
		die "Franken Shell remained registered after $label smoke teardown"
	fi
	if ! wait_for_process_exit "$pid"; then
		die "Franken Shell process remained alive after $label smoke teardown"
	fi
	for child_pid in $descendant_pids; do
		if ! wait_for_process_exit "$child_pid"; then
			die "Franken Shell child process $child_pid remained alive after $label smoke teardown"
		fi
	done
}

./dev/franken-shell mock-healthy
healthy_summary=$(./dev/franken-shell diagnostics | sed -n '1p')
printf '%s\n' "$healthy_summary" >"$smoke_artifact_dir/healthy-summary.json"
printf '%s\n' "$healthy_summary" | jq -e '
    .mode == "readiness-healthy-test"
    and .startupState == "OptionalIntegrationsReady"
    and .shellReady == true
    and .shellDegraded == false
    and .shellFailed == false
    and .capabilityAvailableCount == 7
    and .capabilityUnavailableCount == 0
    and .diagnosticErrorCount == 0
    and .diagnosticServiceCount == 5
    and .barHostCount == 1
    and .barResolvedHostCount == 1
    and .barVisibleHostCount == 1
    and .surfaceActiveCount == 0
    and .surfaceLastTransition == "idle"
    and .themeHealth == "healthy"
    and .themeSource == "builtInFallback"
' >/dev/null

ipc_version=$(./dev/franken-shell ipc-version | sed -n '1p')
printf '%s\n' "$ipc_version" >"$smoke_artifact_dir/ipc-version.json"
printf '%s\n' "$ipc_version" | jq -e '
    .apiVersion == 1
    and .project == "Franken Shell"
' >/dev/null

ipc_diagnostics=$(./dev/franken-shell ipc-diagnostics | sed -n '1p')
printf '%s\n' "$ipc_diagnostics" >"$smoke_artifact_dir/ipc-diagnostics.json"
printf '%s\n' "$ipc_diagnostics" | jq -e '
    .ok == true
    and .operation == "diagnostics"
    and .result.shellReady == true
    and .result.surfaceActiveCount == 0
    and .result.barHostCount == 1
    and .result.barVisibleHostCount == 1
' >/dev/null

ipc_malformed=$(qs ipc --path "$REPO_ROOT/shell" call shell request '{' | sed -n '1p')
printf '%s\n' "$ipc_malformed" >"$smoke_artifact_dir/ipc-malformed.json"
printf '%s\n' "$ipc_malformed" | jq -e '
    .ok == false
    and .error.code == "IPC_MALFORMED_REQUEST"
' >/dev/null

ipc_unsupported=$(qs ipc --path "$REPO_ROOT/shell" call shell request \
	'{"apiVersion":999,"requestId":"smoke.unsupported","operation":"diagnostics","payload":{}}' |
	sed -n '1p')
printf '%s\n' "$ipc_unsupported" >"$smoke_artifact_dir/ipc-unsupported.json"
printf '%s\n' "$ipc_unsupported" | jq -e '
    .ok == false
    and .requestId == "smoke.unsupported"
    and .error.code == "IPC_UNSUPPORTED_VERSION"
' >/dev/null

./dev/franken-shell close-transients >"$smoke_artifact_dir/ipc-close-first.json"
./dev/franken-shell close-transients >"$smoke_artifact_dir/ipc-close-repeated.json"
jq -e '.ok == true and .result.state == "alreadyClosed"' \
	"$smoke_artifact_dir/ipc-close-first.json" >/dev/null
jq -e '.ok == true and .result.state == "alreadyClosed"' \
	"$smoke_artifact_dir/ipc-close-repeated.json" >/dev/null
printf 'shell-ipc pass\n' >>"$smoke_artifact_dir/results.txt"

healthy_instances=$(shell_instances)
healthy_pid=$(printf '%s\n' "$healthy_instances" |
	jq -er 'if length == 1 then .[0].pid else error("expected one healthy fixture instance") end')
capture_log_policy healthy 1
stop_and_check healthy "$healthy_pid"
printf 'healthy-readiness pass\n' >>"$smoke_artifact_dir/results.txt"

./dev/franken-shell mock
summary=$(./dev/franken-shell diagnostics | sed -n '1p')
printf '%s\n' "$summary" >"$smoke_artifact_dir/degraded-initial-summary.json"
printf '%s\n' "$summary" | assert_degraded_summary

instances=$(shell_instances)
printf '%s\n' "$instances" >"$smoke_artifact_dir/degraded-initial-instance.json"
shell_pid=$(printf '%s\n' "$instances" |
	jq -er 'if length == 1 then .[0].pid else error("expected one Franken Shell instance") end')

./dev/franken-shell mock >"$smoke_artifact_dir/degraded-duplicate-start.log"
duplicate_instances=$(shell_instances)
duplicate_pid=$(printf '%s\n' "$duplicate_instances" |
	jq -er 'if length == 1 then .[0].pid else error("duplicate start changed instance count") end')
if [ "$duplicate_pid" -ne "$shell_pid" ]; then
	die "duplicate start replaced the running Franken Shell process"
fi
printf 'duplicate-start pass\n' >>"$smoke_artifact_dir/results.txt"

./dev/franken-shell reload >"$smoke_artifact_dir/degraded-reload.log"
./dev/franken-shell ipc-version >"$smoke_artifact_dir/ipc-version-after-reload.json"
jq -e '.apiVersion == 1' "$smoke_artifact_dir/ipc-version-after-reload.json" >/dev/null
./dev/franken-shell close-transients >"$smoke_artifact_dir/ipc-close-after-reload.json"
jq -e '.ok == true and .result.state == "alreadyClosed"' \
	"$smoke_artifact_dir/ipc-close-after-reload.json" >/dev/null
reloaded_bar_summary=$(./dev/franken-shell ipc-diagnostics | sed -n '1p')
printf '%s\n' "$reloaded_bar_summary" >"$smoke_artifact_dir/bar-after-reload.json"
printf '%s\n' "$reloaded_bar_summary" | jq -e '
    .ok == true
    and .result.barHostCount == 1
    and .result.barResolvedHostCount == 1
    and .result.barVisibleHostCount == 1
' >/dev/null
reloaded_summary=$(./dev/franken-shell diagnostics | sed -n '1p')
printf '%s\n' "$reloaded_summary" >"$smoke_artifact_dir/degraded-reloaded-summary.json"
printf '%s\n' "$reloaded_summary" | assert_degraded_summary

reloaded_instances=$(shell_instances)
reloaded_pid=$(printf '%s\n' "$reloaded_instances" |
	jq -er 'if length == 1 then .[0].pid else error("reload changed instance count") end')
if [ "$reloaded_pid" -ne "$shell_pid" ]; then
	die "soft reload replaced the Franken Shell process"
fi
printf 'soft-reload pass\n' >>"$smoke_artifact_dir/results.txt"

capture_log_policy degraded 2
printf 'log-policy pass\n' >>"$smoke_artifact_dir/results.txt"
stop_and_check degraded "$shell_pid"
printf 'process-cleanup pass\n' >>"$smoke_artifact_dir/results.txt"

./dev/franken-shell mock-required-failure
failure_summary=$(./dev/franken-shell diagnostics | sed -n '1p')
printf '%s\n' "$failure_summary" >"$smoke_artifact_dir/required-failure-summary.json"
printf '%s\n' "$failure_summary" | jq -e '
    .mode == "readiness-required-failure-test"
    and .startupState == "Failed"
    and .shellReady == false
    and .shellFailed == true
    and .shellFailureCode == "FIXTURE_REQUIRED_CORE_FAILURE"
    and .diagnosticCriticalCount == 1
    and .themeHealth == "healthy"
' >/dev/null
failure_instances=$(shell_instances)
failure_pid=$(printf '%s\n' "$failure_instances" |
	jq -er 'if length == 1 then .[0].pid else error("expected one required-failure fixture instance") end')
readiness_status=0
./dev/franken-shell readiness >"$smoke_artifact_dir/required-failure-readiness.json" ||
	readiness_status=$?
if [ "$readiness_status" -ne 1 ]; then
	die "required-core readiness command returned $readiness_status instead of 1"
fi
capture_log_policy required-failure 1 \
	"$CI_DIR/baselines/smoke-required-failure-known.txt"
stop_and_check required-failure "$failure_pid"
printf 'required-core-failure pass\n' >>"$smoke_artifact_dir/results.txt"

trap - EXIT INT TERM
rm -rf "$runtime_dir"

printf 'Healthy, degraded, required-failure, shell-IPC, reload, log, and teardown smoke passed.\n'
