#!/bin/sh

set -eu

# shellcheck source=ci/lib.sh
. "$(dirname -- "$0")/lib.sh"

require_tool qs

cd "$REPO_ROOT"

bar_artifact_dir="$ARTIFACT_DIR/bar"
mkdir -p "$bar_artifact_dir/fixtures"

unset WAYLAND_DISPLAY
unset HYPRLAND_INSTANCE_SIGNATURE
export QT_QPA_PLATFORM=offscreen

if shell/dev/franken-shell daily-bar-check >"$bar_artifact_dir/daily-check.log" 2>&1; then
	cat "$bar_artifact_dir/daily-check.log"
else
	status=$?
	cat "$bar_artifact_dir/daily-check.log" >&2
	exit "$status"
fi

if shell/dev/franken-shell daily-bar-test >"$bar_artifact_dir/daily-test.log" 2>&1; then
	cat "$bar_artifact_dir/daily-test.log"
else
	status=$?
	cat "$bar_artifact_dir/daily-test.log" >&2
	exit "$status"
fi

if shell/dev/franken-shell bar-host-check >"$bar_artifact_dir/check.log" 2>&1; then
	cat "$bar_artifact_dir/check.log"
else
	status=$?
	cat "$bar_artifact_dir/check.log" >&2
	exit "$status"
fi

if FRANKEN_SHELL_ARTIFACT_DIR="$bar_artifact_dir/fixtures" \
	shell/dev/franken-shell bar-host-test >"$bar_artifact_dir/test.log" 2>&1; then
	cat "$bar_artifact_dir/test.log"
else
	status=$?
	cat "$bar_artifact_dir/test.log" >&2
	exit "$status"
fi

if shell/dev/franken-shell audio-adapter-check >"$bar_artifact_dir/audio-check.log" 2>&1; then
	cat "$bar_artifact_dir/audio-check.log"
else
	status=$?
	cat "$bar_artifact_dir/audio-check.log" >&2
	exit "$status"
fi

if shell/dev/franken-shell audio-adapter-test >"$bar_artifact_dir/audio-test.log" 2>&1; then
	cat "$bar_artifact_dir/audio-test.log"
else
	status=$?
	cat "$bar_artifact_dir/audio-test.log" >&2
	exit "$status"
fi

{
	printf 'reportOnly=true\n'
	printf 'scope=composed-bar-fixture\n'
	printf 'samplingPolicy=aligned-minute-clock;summary-telemetry-while-closed;detail-telemetry-while-open\n'
	printf 'liveIdleCpuMemory=manual-session-evidence-required\n'
} >"$bar_artifact_dir/idle-baseline.txt"

printf 'Bar composition, adapter, interaction, fallback, fixture, and report-only baseline contracts passed.\n'
