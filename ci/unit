#!/bin/sh

set -eu

# shellcheck source=ci/lib.sh
. "$(dirname -- "$0")/lib.sh"

require_tool cargo
require_tool qs

cd "$REPO_ROOT"

unit_artifact_dir="$ARTIFACT_DIR/unit"
mkdir -p "$unit_artifact_dir"
: >"$unit_artifact_dir/results.txt"

run_logged() {
	name=$1
	shift
	output="$unit_artifact_dir/$name.log"

	if "$@" >"$output" 2>&1; then
		cat "$output"
		printf '%s pass\n' "$name" >>"$unit_artifact_dir/results.txt"
	else
		status=$?
		cat "$output" >&2
		printf '%s fail (%s)\n' "$name" "$status" >>"$unit_artifact_dir/results.txt"
		return "$status"
	fi
}

run_logged rust cargo test \
	--locked \
	--manifest-path shell/helpers/franken-config-helper/Cargo.toml \
	--all-targets \
	--all-features

unset WAYLAND_DISPLAY
unset HYPRLAND_INSTANCE_SIGNATURE
export QT_QPA_PLATFORM=offscreen

run_logged config-helper-client shell/dev/franken-shell config-helper-client-test
run_logged config-snapshot shell/dev/franken-shell config-snapshot-test
run_logged core-state shell/dev/franken-shell core-state-test
run_logged config-service shell/dev/franken-shell config-service-test
run_logged monitor-registry shell/dev/franken-shell monitor-registry-test
run_logged command-registry env HOME="$(dirname -- "$REPO_ROOT")" \
	shell/dev/franken-shell command-registry-test

printf 'Unit and fixture suites passed; logs are in %s.\n' "$unit_artifact_dir"
